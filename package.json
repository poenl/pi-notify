{
  "name": "pi-notify",
  "version": "0.1.0",
  "private": true,
  "description": "pi 扩展：任务完成/失败、其他扩展等待用户输入时发系统通知（macOS / Windows / Linux）",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src"
    ]
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit && eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "node-notifier": "11.0.0"
  }
}
